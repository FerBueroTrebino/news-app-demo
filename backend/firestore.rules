rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors ArticleNewsEntity.allowedCategories
    function articleCategories() {
      return [
        'general',
        'business',
        'entertainment',
        'health',
        'science',
        'sport',
        'technology',
      ];
    }

    // Mirrors ArticleNewsEntity.allowedStatuses
    function articleStatuses() {
      return ['draft', 'published', 'archived'];
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function isStringUpTo(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function stringLenInRange(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    // Article document shape for create (matches ArticleNewsModel.toFirestoreCreateMap).
    function articleCreateKeysWithPublishedAt() {
      return [
        'articleUid',
        'title',
        'description',
        'content',
        'category',
        'status',
        'thumbnailUrl',
        'authorUid',
        'authorName',
        'createdAt',
        'publishedAt',
        'updatedAt',
        'viewsCount',
      ];
    }

    function articleCreateKeysWithoutPublishedAt() {
      return [
        'articleUid',
        'title',
        'description',
        'content',
        'category',
        'status',
        'thumbnailUrl',
        'authorUid',
        'authorName',
        'createdAt',
        'updatedAt',
        'viewsCount',
      ];
    }

    function validArticleCreate(articleId) {
      let data = request.resource.data;
      return request.auth != null
        && data.articleUid == articleId
        && data.articleUid is string
        && data.articleUid.size() > 0
        && data.authorUid == request.auth.uid
        && stringLenInRange(data.title, 3, 120)
        && stringLenInRange(data.description, 90, 250)
        && stringLenInRange(data.content, 100, 20000)
        && data.category is string
        && data.category in articleCategories()
        && data.status is string
        && data.status in articleStatuses()
        && data.thumbnailUrl is string
        && data.thumbnailUrl.size() <= 2048
        && isNonEmptyString(data.authorName, 200)
        && data.viewsCount is int
        && data.viewsCount == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (
          data.keys().hasOnly(articleCreateKeysWithoutPublishedAt())
          || (
            data.keys().hasOnly(articleCreateKeysWithPublishedAt())
            && data.publishedAt is timestamp
          )
          || (
            data.keys().hasOnly(articleCreateKeysWithPublishedAt())
            && data.publishedAt == null
          )
        );
    }

    function canReadArticle() {
      return resource.data.status == 'published'
        || (
          request.auth != null
          && resource.data.authorUid == request.auth.uid
        );
    }

    // Author document shape for initial set (AuthorModel.toFirestoreCreateMap).
    function authorCreateKeys() {
      return [
        'uid',
        'username',
        'nameToDisplay',
        'email',
        'biografy',
        'image',
        'articles',
        'createdAt',
        'totalViews',
        'lastActiveAt',
      ];
    }

    function validAuthorCreate(userId) {
      let data = request.resource.data;
      return request.auth != null
        && userId == request.auth.uid
        && data.uid == userId
        && data.keys().hasOnly(authorCreateKeys())
        && data.username is string
        && isNonEmptyString(data.username, 200)
        && isNonEmptyString(data.nameToDisplay, 200)
        && (data.email == null || (data.email is string && data.email.size() <= 320))
        && data.biografy is string
        && data.biografy.size() <= 10000
        && data.image is string
        && data.image.size() <= 2048
        && data.articles is list
        && data.articles.size() == 0
        && data.createdAt == request.time
        && data.totalViews is int
        && data.totalViews == 0
        && data.lastActiveAt == request.time;
    }

    function validAuthorLoginTouch() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
        && affected.hasOnly(['lastActiveAt'])
        && request.resource.data.lastActiveAt == request.time
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nameToDisplay == resource.data.nameToDisplay;
    }

    match /articles/{articleId} {
      allow create: if validArticleCreate(articleId);
      allow read: if canReadArticle();
      allow update, delete: if false;
    }

    match /authors/{userId} {
      allow create: if validAuthorCreate(userId);
      allow read: if request.auth != null;
      allow update: if request.auth.uid == userId && validAuthorLoginTouch();
      allow delete: if false;
    }
  }
}
